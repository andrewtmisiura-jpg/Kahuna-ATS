# Tidepool environment variables. Copy to .env for local development.
# Only DATABASE_URL and DEV_AUTH_EMAIL are needed to run the app locally.
# In production every value is pasted into Railway by the owner; nothing is committed.

# Postgres (local cluster from `pnpm db:local:init`; Railway sets its own)
DATABASE_URL=postgres://postgres@127.0.0.1:54329/tidepool
# Used by Vitest only: migrations are applied to this database fresh on every run
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:54329/tidepool_test

# Public address of the app, used in links, QR codes and the sign-in redirect
PUBLIC_BASE_URL=http://localhost:3000

# Better Auth: a random secret of 32+ characters (`openssl rand -base64 32`) and the base URL
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (OAuth client with email and profile scopes only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development only: sign in as this email without Google. Ignored when NODE_ENV=production.
DEV_AUTH_EMAIL=you@example.com

# The first Admin account (the owner's Google email). `pnpm db:seed` refuses to run without it.
ADMIN_EMAIL=you@example.com

# The Admin `pnpm legal:publish` records as the publisher; blank means ADMIN_EMAIL.
LEGAL_PUBLISH_AS=

# Message providers: "live" sends through Quo and Resend, "sink" records sends without
# sending. Defaults to live in production and sink everywhere else; leave unset locally.
MESSAGE_PROVIDERS=

# Quo (texts from the hiring number): API key labeled Tidepool and the webhook signing secret
QUO_API_KEY=
QUO_WEBHOOK_SECRET=
# Override only for a Quo sandbox; the send function posts to <base>/v1/messages
QUO_API_BASE_URL=https://api.quo.com

# Resend (email) and its webhook signing secret for bounces and complaints
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Cloudflare Turnstile on the landing and lost-link pages
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where notifyAdmin alerts and the daily digest go (the owner's address, not hiring@)
ALERT_EMAIL=

# First deploy only: "true" lets /health pass before the cron service has written a heartbeat.
CRON_HEARTBEAT_OPTIONAL=

# Cloudflare R2 bucket for the nightly pg_dump
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Directory holding pg_dump and pg_restore when the right ones are not on PATH; unset on Railway.
PG_BIN=
