{
  "name": "tidepool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/run.ts",
    "user:add-admin": "tsx src/cli/add-admin.ts",
    "db:local:init": "bash scripts/db-local.sh init",
    "db:local:start": "bash scripts/db-local.sh start",
    "db:local:stop": "bash scripts/db-local.sh stop",
    "cron": "tsx src/cron/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@hookform/resolvers": "5.9.1",
    "better-auth": "1.7.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "resend": "6.33.0",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
