# syntax=docker/dockerfile:1
#
# The cron service image (railway.cron.json points Railway at this file). It is
# the same codebase as the web service, run as `pnpm cron` every 5 minutes. It
# exists because production Postgres on Railway is version 18 and pg_dump refuses
# to dump a server newer than itself, while Debian bookworm only ships
# postgresql-client-15. So the nightly backup gets postgresql-client-18 from the
# PostgreSQL apt repository (apt.postgresql.org, bookworm-pgdg), which puts
# pg_dump 18 on PATH; PG_BIN stays unset. The backup service still compares
# `pg_dump --version` with the server and refuses with an alert if they drift.
# If the database moves to a newer major version, change postgresql-client-18 below.

FROM node:22-bookworm-slim

# The version 18 binaries go first on PATH, so plain `pg_dump` is pg_dump 18 without
# going through Debian's pg_wrapper version picker.
ENV TZ=UTC \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PATH=/usr/lib/postgresql/18/bin:$PATH

# The PostgreSQL apt repository, signed by its published key, then the version 18 client.
# The last line fails the build unless pg_dump on PATH is version 18.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl --fail --silent --show-error --location \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-18 \
 && apt-get purge -y --auto-remove curl \
 && rm -rf /var/lib/apt/lists/* \
 && pg_dump --version | grep -q "(PostgreSQL) 18"

WORKDIR /app

# pnpm at the version package.json pins (packageManager), through corepack.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && corepack install

# Dependencies first so they cache between deploys, then the rest of the repo.
RUN pnpm install --frozen-lockfile
COPY . .

ENV NODE_ENV=production

CMD ["pnpm", "cron"]
